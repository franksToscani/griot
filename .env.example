APP_NAME=Griot
APP_ENV=local
APP_KEY=
# true only in local development: in production always false (see .env.production.example and
# docs/production.md), or the error pages show code and data to anyone.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
# Languages to review before they are open to everyone, comma separated, for example "xx" for a
# language that is known in config/app.php but not open yet. Today none: every known one is open.
# APP_PREVIEW_LOCALES=
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# In production: LOG_CHANNEL=stderr (the host keeps the log), or LOG_CHANNEL=daily with
# LOG_DAILY_DAYS=14 so that old files are deleted. "stack" with "single" (below) is for local
# development only: laravel.log grows without limit.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=griot
DB_USERNAME=griot
DB_PASSWORD=*****


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The disk of the images (docs/media-storage.md): local in development, s3 in production.
MEDIA_DISK_DRIVER=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes every email, whole, in laravel.log: local development only. Never in production,
# where with "log" or "array" the web pages, the queue worker and the scheduler refuse to start
# (App\Support\ProductionMailer); migrate and the build still work.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Who handles the personal data, shown on the privacy page; without them the page shows a
# placeholder. PRIVACY_REVIEWED=true only once a competent person has checked the text.
# PRIVACY_CONTROLLER_NAME="Example Name"
# PRIVACY_CONTACT_EMAIL=privacy@example.com
# PRIVACY_REVIEWED=false

# The site's own contacts, in the footer of every public page (config/contact.php). Empty: the
# footer shows only the privacy link. CONTACT_WHATSAPP in international format, with + or 00
# (for example +39 followed by the number); any other value is not shown. Not the privacy
# contact above. On the production server, set them as variables of the hosting service.
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# With MEDIA_DISK_DRIVER=s3 the images go to an S3-compatible bucket. Example for Scaleway
# Object Storage in Paris (the keys only as variables of the hosting service, never here):
# AWS_DEFAULT_REGION=fr-par
# AWS_BUCKET=griot-media
# AWS_ENDPOINT=https://s3.fr-par.scw.cloud
# AWS_URL=https://griot-media.s3.fr-par.scw.cloud
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
