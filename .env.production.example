# Griot in produzione (docs/production.md). Esempio SENZA segreti: i valori veri si scrivono solo
# come variabili d'ambiente del servizio di hosting, mai in un file nel repository.
# Le righe marcate [SEGRETO] vanno tenute private; <da-compilare> è un segnaposto.

# --- Applicazione ---------------------------------------------------------------------------
APP_NAME=Griot
# Sempre production: abilita i controlli di produzione (mailer vero, seeder di sviluppo bloccati, HSTS).
APP_ENV=production
# [SEGRETO] Chiave di cifratura di sessioni e cookie: "php artisan key:generate --show", una volta sola.
APP_KEY=<da-compilare>
# Sempre false: con true gli errori mostrano codice e dati a chiunque.
APP_DEBUG=false
# L'indirizzo pubblico in https: link nelle email, anteprime dei link, URL generati.
APP_URL=https://griot.example.test
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
# Lingue da rivedere prima di aprirle a tutti, separate da virgole. Vuoto: tutte aperte.
APP_PREVIEW_LOCALES=
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Proxy dell'hosting ---------------------------------------------------------------------------
# "*" dietro il bilanciatore del servizio di hosting (l'app è raggiungibile solo da lì), oppure gli
# indirizzi dei proxy separati da virgole. Serve per l'IP vero dei clienti (limiti di richieste) e
# per i link in https. Vuoto: nessun proxy fidato.
TRUSTED_PROXIES=*

# --- Sito privato ---------------------------------------------------------------------------------
# true finché il sito è online ma privato (testi legali non rivisti): ogni risposta ha
# "X-Robots-Tag: noindex, nofollow" e /robots.txt vieta tutto. false all'apertura al pubblico.
SITE_NOINDEX=true

# --- Log -------------------------------------------------------------------------------------------
# stderr: il servizio di hosting raccoglie i log; nessun file sul disco effimero.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Database --------------------------------------------------------------------------------------
# Il motore scelto per la produzione (docs/production.md): pgsql o mysql.
DB_CONNECTION=pgsql
DB_HOST=<da-compilare>
DB_PORT=5432
DB_DATABASE=griot
DB_USERNAME=griot
# [SEGRETO]
DB_PASSWORD=<da-compilare>
# In alternativa a host, porta, nome, utente e password: l'indirizzo completo. [SEGRETO]
DB_URL=
# Connessione cifrata con il database gestito.
DB_SSLMODE=require

# --- Sessioni, cache, code -------------------------------------------------------------------------
# Tutto nel database: il disco del servizio si cancella a ogni deploy.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
# Il cookie di sessione viaggia solo in https.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Immagini (docs/media-storage.md) --------------------------------------------------------------
# s3: un archivio compatibile S3; mai le immagini sul disco del servizio.
MEDIA_DISK_DRIVER=s3
# [SEGRETO]
AWS_ACCESS_KEY_ID=<da-compilare>
# [SEGRETO]
AWS_SECRET_ACCESS_KEY=<da-compilare>
AWS_DEFAULT_REGION=<da-compilare>
AWS_BUCKET=<da-compilare>
AWS_ENDPOINT=https://s3.example.test
AWS_URL=https://media.example.test
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Email -----------------------------------------------------------------------------------------
# Un mailer vero (smtp o un fornitore): con log o array la pagina, la coda e lo scheduler non
# partono (App\Support\ProductionMailer).
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_USERNAME=<da-compilare>
# [SEGRETO]
MAIL_PASSWORD=<da-compilare>
# Un indirizzo del dominio verificato presso il fornitore (SPF e DKIM).
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"

# --- Contatti del sito (footer e fascia per i professionisti) --------------------------------------
# Vuoti: nessun contatto mostrato. WhatsApp in formato internazionale con + o 00.
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# --- Privacy (issue #131) --------------------------------------------------------------------------
# Chi tratta i dati, mostrato in /privacy. PRIVACY_REVIEWED=true solo dopo la revisione del testo.
PRIVACY_CONTROLLER_NAME=<da-compilare>
PRIVACY_CONTACT_EMAIL=privacy@example.test
PRIVACY_REVIEWED=false

# --- Termini d'uso (issue #131) --------------------------------------------------------------------
# Chi pubblica il sito, mostrato in /terms. TERMS_REVIEWED=true solo dopo la revisione del testo.
TERMS_PUBLISHER_NAME=<da-compilare>
TERMS_PUBLISHER_ADDRESS=<da-compilare>
TERMS_PUBLISHER_VAT_NUMBER=<da-compilare>
TERMS_REVIEWED=false

VITE_APP_NAME="${APP_NAME}"
